# ============================================================
#  Скопируйте в .env и заполните. Файл .env в git не попадает.
#  На сервере: chmod 600 .env
# ============================================================

# --- Web3Forms: письма с формы на почту (https://web3forms.com) ---
# Ключ публичный по своей природе (уходит в бандл, если API-сервер не поднят).
VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here

# --- Yandex SmartCaptcha (https://yandex.cloud/ru/docs/smartcaptcha/quickstart) ---
# Без этих ключей форма шлётся напрямую в Web3Forms из браузера — спам-риск выше.
# С ключами запрос идёт через /api/contact, где капча проверяется на сервере.
VITE_YANDEX_SMARTCAPTCHA_CLIENT_KEY=
YANDEX_SMARTCAPTCHA_SERVER_KEY=

# --- API формы ---
# URL эндпоинта на клиенте (по умолчанию /api/contact — тот же домен)
# VITE_CONTACT_API_URL=/api/contact
# Хост и порт Node-процесса формы (наружу его публикует nginx)
# CONTACT_API_HOST=127.0.0.1
# CONTACT_API_PORT=8787
# Откуда принимаются запросы к API (через запятую)
# CONTACT_ALLOWED_ORIGINS=https://rrysbekov.ru,https://www.rrysbekov.ru

# --- Яндекс Метрика (https://metrika.yandex.ru) ---
VITE_YANDEX_METRICA_ID=110152126
