# Единые переносы строк во всём репозитории: LF в git и в рабочей копии.
# Без этого Windows-клиент помечает все файлы изменёнными (CRLF vs LF).
* text=auto eol=lf

*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Бинарные файлы git не трогает
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.mp4  binary
*.zip  binary

# Не раздувать diff в PR
package-lock.json -diff linguist-generated
