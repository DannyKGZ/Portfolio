# Web3Forms — письма на email: https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Yandex Smart Captcha — https://yandex.cloud/en/docs/smartcaptcha/quickstart
# Клиентский ключ (виден на сайте)
VITE_YANDEX_SMARTCAPTCHA_CLIENT_KEY=your-client-key-here
# Серверный ключ (только на сервере, не добавляйте префикс VITE_)
YANDEX_SMARTCAPTCHA_SERVER_KEY=your-server-key-here

# Опционально: URL API формы (по умолчанию /api/contact)
# VITE_CONTACT_API_URL=/api/contact

# Яндекс Метрика — https://metrika.yandex.ru (счётчик → Настройки → ID счётчика)
VITE_YANDEX_METRICA_ID=110152126
